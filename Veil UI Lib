        Text             = "",
        PlaceholderText  = "🔍 Search...",
        TextColor3       = theme.InputText,
        PlaceholderColor3 = theme.InputPlaceholder,
        TextSize         = 11,
        Font             = Enum.Font.Gotham,
        ClearTextOnFocus = false,
        Parent           = tabBar
    })
    RoundCorners(searchBox, 5)
    New("UIStroke", { Color = theme.InputBorder, Thickness = 1, Parent = searchBox })

    -- ── WINDOW METHODS ──────────────────────────
    function Window:SetTheme(themeName)
        -- hot-swap theme — rebuilds colors on all tracked elements
        -- (kept minimal; for full rebuild just re-create the window)
        theme = Veil.Themes[themeName] or theme
        self.Theme = theme
    end

    function Window:Tab(name, icon)
        local Tab    = { Sections = {}, Components = {} }
        local isActive = false

        -- tab button
        local btn = New("TextButton", {
            Size             = UDim2.new(1, 0, 0, 32),
            BackgroundColor3 = theme.TabIdle,
            Text             = (icon and icon .. "  " or "") .. name,
            TextColor3       = theme.TabText,
            TextSize         = 12,
            Font             = Enum.Font.Gotham,
            AutoButtonColor  = false,
            Parent           = tabBar
        })
        RoundCorners(btn, 6)

        -- tab content page
        local page = New("ScrollingFrame", {
            Size                  = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            BorderSizePixel       = 0,
            ScrollBarThickness    = 3,
            ScrollBarImageColor3  = theme.ScrollBar,
            CanvasSize            = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize   = Enum.AutomaticSize.Y,
            Visible               = false,
            Parent                = contentArea
        })
        AddListLayout(page, Enum.FillDirection.Vertical, 6)
        AddPadding(page, 10, 10)

        local function Activate()
            for _, t in pairs(TabList) do
                Tween(t.btn, { BackgroundColor3 = theme.TabIdle }, 0.15):Play()
                t.btn.TextColor3 = theme.TabText
                t.btn.Font       = Enum.Font.Gotham
                t.page.Visible   = false
            end
            Tween(btn, { BackgroundColor3 = theme.TabActive }, 0.15):Play()
            btn.TextColor3 = theme.TabTextActive
            btn.Font       = Enum.Font.GothamBold
            page.Visible   = true
            isActive       = true
            Window.ActiveTab = Tab
        end

        btn.MouseButton1Click:Connect(Activate)
        btn.MouseEnter:Connect(function()
            if not isActive then
                Tween(btn, { BackgroundColor3 = theme.ComponentHover }, 0.1):Play()
            end
        end)
        btn.MouseLeave:Connect(function()
            if not isActive then
                Tween(btn, { BackgroundColor3 = theme.TabIdle }, 0.1):Play()
            end
        end)

        table.insert(TabList, { btn = btn, page = page, name = name })
        if #TabList == 1 then Activate() end

        -- search filter
        searchBox:GetPropertyChangedSignal("Text"):Connect(function()
            local query = searchBox.Text:lower()
            for _, comp in pairs(Tab.Components) do
                if comp._frame then
                    comp._frame.Visible = query == "" or comp._name:lower():find(query, 1, true) ~= nil
                end
            end
        end)

