    local content = New("Frame", {
        Position         = UDim2.new(0,148,0,46),
        Size             = UDim2.new(1,-148,1,-46),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        ZIndex           = 2,
        Parent           = main
    })

    -- ══════════════════════════════════════════════
    --  TAB
    -- ══════════════════════════════════════════════
    function W:Tab(tcfg)
        tcfg = tcfg or {}
        local Tab     = { _comps = {} }
        local active  = false

        local page = New("ScrollingFrame", {
            Size                  = UDim2.new(1,0,1,0),
            BackgroundTransparency = 1,
            BorderSizePixel       = 0,
            ScrollBarThickness    = 3,
            ScrollBarImageColor3  = th.Scroll,
            CanvasSize            = UDim2.new(0,0,0,0),
            AutomaticCanvasSize   = Enum.AutomaticSize.Y,
            Visible               = false,
            ZIndex                = 2,
            Parent                = content
        })
        List(page, Enum.FillDirection.Vertical, 6)
        Pad(page, 10, 10)

        local btnIcon = tcfg.Icon and (tcfg.Icon .. "  ") or ""
        local btn = New("TextButton", {
            Size             = UDim2.new(1,0,0,34),
            BackgroundColor3 = th.TabIdle,
            Text             = btnIcon .. (tcfg.Name or "Tab"),
            TextColor3       = th.TabTxt,
            TextSize         = 12,
            Font             = Enum.Font.Gotham,
            AutoButtonColor  = false,
            ZIndex           = 3,
            Parent           = tabScroll
        })
        Corner(btn, 7)

        -- active indicator bar
        local ind = New("Frame", {
            AnchorPoint      = Vector2.new(0,0.5),
            Position         = UDim2.new(0,0,0.5,0),
            Size             = UDim2.new(0,0,0,20),
            BackgroundColor3 = th.Acc,
            BorderSizePixel  = 0,
            ZIndex           = 4,
            Parent           = btn
        })
        Corner(ind, 3)

        local function SetActive(v)
            active = v
            if v then
                Tween(btn, { BackgroundColor3 = th.TabActive }, 0.15)
                btn.TextColor3 = th.TabTxtA
                btn.Font       = Enum.Font.GothamBold
                Spring(ind, { Size = UDim2.new(0,3,0,20) }, 0.3)
                page.Visible   = true
                W._active      = Tab
            else
                Tween(btn, { BackgroundColor3 = th.TabIdle }, 0.15)
                btn.TextColor3 = th.TabTxt
                btn.Font       = Enum.Font.Gotham
                Tween(ind, { Size = UDim2.new(0,0,0,20) }, 0.15)
                page.Visible   = false
            end
        end

        btn.MouseButton1Click:Connect(function()
            for _, t in pairs(W._tabs) do t._setActive(false) end
            SetActive(true)
        end)
        btn.MouseEnter:Connect(function()
            if not active then
                Tween(btn, { BackgroundColor3 = th.CompHov }, 0.1)
            end
        end)
        btn.MouseLeave:Connect(function()
            if not active then
                Tween(btn, { BackgroundColor3 = th.TabIdle }, 0.1)
            end
        end)

        Tab._setActive = SetActive
        Tab._page      = page
        Tab._name      = tcfg.Name or "Tab"

        table.insert(W._tabs, Tab)
        if #W._tabs == 1 then SetActive(true) end

        -- search wiring
        searchBox:GetPropertyChangedSignal("Text"):Connect(function()
            local q = searchBox.Text:lower()
            for _, comp in pairs(Tab._comps) do
                if comp._frame then
                    comp._frame.Visible = (q == "") or (comp._name:lower():find(q,1,true) ~= nil)
                end
            end
        end)

        -- ════════════════════════════════════════════
        --  SECTION
        -- ════════════════════════════════════════════
        function Tab:Section(scfg)
            scfg = scfg or {}
            local Sec    = { _comps = {} }
            local isCol  = scfg.Collapsed or false

            local wrap = New("Frame", {
                Size             = UDim2.new(1,0,0,0),
                AutomaticSize    = Enum.AutomaticSize.Y,
                BackgroundColor3 = th.SecBg,
                ZIndex           = 2,
                Parent           = page
            })
            Corner(wrap, 9)
            Stroke(wrap, th.SecBdr, 1)

            -- section header
            local hdr = New("TextButton", {
                Size             = UDim2.new(1,0,0,32),
                BackgroundTransparency = 1,
                Text             = "",
                AutoButtonColor  = false,
                ZIndex           = 3,
                Parent           = wrap
            })
            New("TextLabel", {
                Position         = UDim2.new(0,12,0,0),
                Size             = UDim2.new(1,-40,1,0),
                BackgroundTransparency = 1,
                Text             = (scfg.Icon and scfg.Icon .. "  " or "") .. (scfg.Name or "Section"),
                TextColor3       = th.SecTitle,
                TextSize         = 12,
                Font             = Enum.Font.GothamBold,
                TextXAlignment   = Enum.TextXAlignment.Left,
                ZIndex           = 4,
                Parent           = hdr
            })
            local arw = New("TextLabel", {
                AnchorPoint      = Vector2.new(1,0.5),
                Position         = UDim2.new(1,-12,0.5,0),
                Size             = UDim2.new(0,14,0,14),
                BackgroundTransparency = 1,
                Text             = isCol and "▶" or "▼",
                TextColor3       = th.SecTitle,
                TextSize         = 9,
                Font             = Enum.Font.GothamBold,
                ZIndex           = 4,
                Parent           = hdr
            })
            -- accent accent dot next to title
            New("Frame", {
                Position         = UDim2.new(0,5,0.5,-4),
                Size             = UDim2.new(0,4,0,4),
                BackgroundColor3 = th.Acc,
                BorderSizePixel  = 0,
                ZIndex           = 4,
                Parent           = hdr
            })

            -- separator line
            New("Frame", {
                Position         = UDim2.new(0,10,0,32),
                Size             = UDim2.new(1,-20,0,1),
                BackgroundColor3 = th.Sep,
                BorderSizePixel  = 0,
                ZIndex           = 3,
                Parent           = wrap
            })

            local compContainer = New("Frame", {
                Position         = UDim2.new(0,0,0,33),
                Size             = UDim2.new(1,0,0,0),
                AutomaticSize    = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                ClipsDescendants = true,
                ZIndex           = 2,
                Parent           = wrap
            })
            List(compContainer, Enum.FillDirection.Vertical, 4)
            Pad(compContainer, 8, 6)

            if isCol then compContainer.Visible = false end

            hdr.MouseButton1Click:Connect(function()
                isCol = not isCol
                compContainer.Visible = not isCol
                arw.Text = isCol and "▶" or "▼"
            end)

            -- ──────────────────────────────────────────────
            --  COMPONENT HELPERS
            -- ──────────────────────────────────────────────
            local function Row(h)
                local r = New("Frame", {
                    Size             = UDim2.new(1,0,0,h or 36),
                    BackgroundColor3 = th.CompBg,
                    ZIndex           = 3,
                    Parent           = compContainer
                })
                Corner(r, 6)
                Stroke(r, th.CompBdr, 1)
                r.MouseEnter:Connect(function() Tween(r,{BackgroundColor3=th.CompHov},0.1) end)
                r.MouseLeave:Connect(function() Tween(r,{BackgroundColor3=th.CompBg},0.1) end)
                return r
            end

            local function Lbl(p,txt,x,y,w,h,sz,fnt,col,xa)
                return New("TextLabel",{
                    Position  = UDim2.new(0,x,0,y),
                    Size      = UDim2.new(0,w,0,h),
                    BackgroundTransparency = 1,
                    Text      = txt,
                    TextColor3= col or th.LblTxt,
                    TextSize  = sz  or 12,
                    Font      = fnt or Enum.Font.Gotham,
                    TextXAlignment = xa or Enum.TextXAlignment.Left,
                    TextTruncate   = Enum.TextTruncate.AtEnd,
                    ZIndex    = 4,
                    Parent    = p
                })
            end

            local function RegComp(comp)
                table.insert(Sec._comps, comp)
                table.insert(Tab._comps, comp)
                return comp
            end

            -- ════════════════════
            --  TOGGLE
            -- ════════════════════
            function Sec:Toggle(c)
                c   = c or {}
                local val = c.Default or false
                if c.Flag then Veil.Flags[c.Flag] = val end
                local hasDesc = c.Desc and c.Desc ~= ""
                local rowH    = hasDesc and 46 or 36
                local r       = Row(rowH)

                Lbl(r, c.Name or "Toggle", 12, hasDesc and 4 or 0, 200, hasDesc and 18 or rowH)
                if hasDesc then
                    Lbl(r, c.Desc, 12, 22, 220, 14, 10, Enum.Font.Gotham, th.DescTxt)
                end

                local track = New("Frame", {
                    AnchorPoint      = Vector2.new(1,0.5),
                    Position         = UDim2.new(1,-10,0.5,0),
                    Size             = UDim2.new(0,38,0,20),
                    BackgroundColor3 = val and th.TglOn or th.TglOff,
                    ZIndex           = 5,
                    Parent           = r
                })
                Corner(track,10)
                GlowFrame(track, th.Acc, UDim2.new(1,20,1,20))

                local knob = New("Frame", {
                    AnchorPoint      = Vector2.new(0,0.5),
                    Position         = UDim2.new(0,val and 19 or 2,0.5,0),
                    Size             = UDim2.new(0,16,0,16),
                    BackgroundColor3 = th.TglKnob,
                    ZIndex           = 6,
                    Parent           = track
                })
                Corner(knob,8)

                New("TextButton",{
                    Size = UDim2.new(1,0,1,0),
                    BackgroundTransparency=1, Text="", ZIndex=7, Parent=r
                }).MouseButton1Click:Connect(function()
                    val = not val
                    if c.Flag then Veil.Flags[c.Flag] = val end
                    Tween(track,{BackgroundColor3=val and th.TglOn or th.TglOff},0.18)
                    Spring(knob,{Position=UDim2.new(0,val and 19 or 2,0.5,0)},0.3)
                    if c.Callback then c.Callback(val) end
                end)

                return RegComp({
                    _frame=r, _name=c.Name or "",
                    Set=function(self,v)
                        val=v
                        if c.Flag then Veil.Flags[c.Flag]=v end
                        Tween(track,{BackgroundColor3=v and th.TglOn or th.TglOff},0.18)
                        Spring(knob,{Position=UDim2.new(0,v and 19 or 2,0.5,0)},0.3)
                        if c.Callback then c.Callback(v) end
                    end,
                    Get=function(self) return val end
                })
            end

            -- ════════════════════
            --  SLIDER
            -- ════════════════════
            function Sec:Slider(c)
                c = c or {}
                local mn,mx,st = c.Min or 0, c.Max or 100, c.Step or 1
                local val = c.Default or mn
                if c.Flag then Veil.Flags[c.Flag] = val end
                local r = Row(52)

                Lbl(r, c.Name or "Slider", 12, 5, 200, 16)
                local vLbl = New("TextLabel",{
                    AnchorPoint=Vector2.new(1,0),
                    Position=UDim2.new(1,-10,0,5),
                    Size=UDim2.new(0,90,0,16),
                    BackgroundTransparency=1,
                    Text=tostring(val)..(c.Suffix or ""),
                    TextColor3=th.Acc,
                    TextSize=11, Font=Enum.Font.GothamBold,
                    TextXAlignment=Enum.TextXAlignment.Right,
                    ZIndex=5,Parent=r
                })

                local trk = New("Frame",{
                    Position=UDim2.new(0,12,0,28),
                    Size=UDim2.new(1,-24,0,6),
                    BackgroundColor3=th.SldTrack,
                    ZIndex=4,Parent=r
                })
                Corner(trk,3)

                local fill = New("Frame",{
                    Size=UDim2.new((val-mn)/(mx-mn),0,1,0),
                    BackgroundColor3=th.SldFill,
                    ZIndex=5,Parent=trk
                })
                Corner(fill,3)
                if th.SldFill2 then Gradient(fill,th.SldFill,th.SldFill2,0) end

                local knob = New("Frame",{
                    AnchorPoint=Vector2.new(0.5,0.5),
                    Position=UDim2.new((val-mn)/(mx-mn),0,0.5,0),
                    Size=UDim2.new(0,13,0,13),
                    BackgroundColor3=th.SldKnob,
                    ZIndex=6,Parent=trk
                })
                Corner(knob,7)
                GlowFrame(knob,th.Acc,UDim2.new(1,12,1,12))

                local dragging=false
                local function Upd(i)
                    local rel=math.clamp((i.Position.X-trk.AbsolutePosition.X)/trk.AbsoluteSize.X,0,1)
                    val=math.clamp(math.round((mn+(mx-mn)*rel)/st)*st,mn,mx)
                    if c.Flag then Veil.Flags[c.Flag]=val end
                    local pct=(val-mn)/(mx-mn)
                    Tween(fill,{Size=UDim2.new(pct,0,1,0)},0.05)
                    Tween(knob,{Position=UDim2.new(pct,0,0.5,0)},0.05)
                    vLbl.Text=tostring(val)..(c.Suffix or "")
                    if c.Callback then c.Callback(val) end
                end
                trk.InputBegan:Connect(function(i)
                    if i.UserInputType==Enum.UserInputType.MouseButton1
                    or i.UserInputType==Enum.UserInputType.Touch then
                        dragging=true Upd(i)
                    end
                end)
                UIS.InputChanged:Connect(function(i)
                    if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement
                    or i.UserInputType==Enum.UserInputType.Touch) then Upd(i) end
                end)
                UIS.InputEnded:Connect(function(i)
                    if i.UserInputType==Enum.UserInputType.MouseButton1
                    or i.UserInputType==Enum.UserInputType.Touch then dragging=false end
                end)

                return RegComp({
                    _frame=r,_name=c.Name or "",
                    Set=function(self,v)
                        val=math.clamp(v,mn,mx)
                        if c.Flag then Veil.Flags[c.Flag]=val end
                        local pct=(val-mn)/(mx-mn)
                        Tween(fill,{Size=UDim2.new(pct,0,1,0)},0.15)
                        Tween(knob,{Position=UDim2.new(pct,0,0.5,0)},0.15)
                        vLbl.Text=tostring(val)..(c.Suffix or "")
                        if c.Callback then c.Callback(val) end
                    end,
                    Get=function(self) return val end
                })
            end

            -- ════════════════════
            --  BUTTON (3 styles)
            -- ════════════════════
            function Sec:Button(c)
                c=c or {}
                local style=c.Style or "fill"   -- "fill"|"outline"|"ghost"
                local r=Row(38)

                local bg = style=="fill"    and th.BtnBg
                        or style=="outline" and Color3.fromRGB(0,0,0)
                        or th.CompBg

                local btn=New("TextButton",{
                    Position=UDim2.new(0,10,0.5,-13),
                    Size=UDim2.new(1,-20,0,26),
                    BackgroundColor3=bg,
                    BackgroundTransparency=style=="ghost" and 0.5 or 0,
                    Text=c.Name or "Button",
                    TextColor3=style=="outline" and th.Acc or th.BtnTxt,
                    TextSize=12,Font=Enum.Font.GothamBold,
                    AutoButtonColor=false,ZIndex=5,Parent=r
                })
                Corner(btn,6)
                if style=="fill" and th.BtnBg2 then
                    Gradient(btn, th.BtnBg, th.BtnBg2, 0)
                end
                if style=="outline" then Stroke(btn,th.Acc,1) end

                btn.MouseEnter:Connect(function()
                    Spring(btn,{Size=UDim2.new(1,-16,0,26)},0.3)
                    Tween(btn,{BackgroundColor3=th.BtnHov},0.12)
                end)
                btn.MouseLeave:Connect(function()
                    Spring(btn,{Size=UDim2.new(1,-20,0,26)},0.3)
                    Tween(btn,{BackgroundColor3=bg},0.12)
                end)
                btn.MouseButton1Down:Connect(function()
                    Tween(btn,{Size=UDim2.new(1,-22,0,24)},0.06)
                end)
                btn.MouseButton1Up:Connect(function()
                    Spring(btn,{Size=UDim2.new(1,-16,0,26)},0.3)
                end)
                btn.MouseButton1Click:Connect(function()
                    if c.Callback then c.Callback() end
                end)

                return RegComp({_frame=r,_name=c.Name or ""})
            end

            -- ════════════════════
            --  DROPDOWN (single + multi + searchable)
            -- ════════════════════
            function Sec:Dropdown(c)
                c=c or {}
                local opts=c.Options or {}
                local multi=c.Multi or false
                local sel=multi and {} or (c.Default or (opts[1] or "Select..."))
                if c.Flag then Veil.Flags[c.Flag]=sel end

                local isOpen=false
                local r=Row(36)
                Lbl(r,c.Name or "Dropdown",12,0,160,36)

                local function SelText()
                    if multi then
                        local names={}
                        for k in pairs(sel) do table.insert(names,k) end
                        return #names>0 and table.concat(names,", ") or "Select..."
                    end
                    return tostring(sel)
                end

                local disp=New("TextButton",{
                    AnchorPoint=Vector2.new(1,0.5),
                    Position=UDim2.new(1,-8,0.5,0),
                    Size=UDim2.new(0,140,0,24),
                    BackgroundColor3=th.DdBg,
                    Text=SelText(),
                    TextColor3=th.LblTxt,
                    TextSize=11,Font=Enum.Font.Gotham,
                    AutoButtonColor=false,
                    ClipsDescendants=true,
                    ZIndex=5,Parent=r
                })
                Corner(disp,6)
                Stroke(disp,th.CompBdr,1)
                New("TextLabel",{
                    AnchorPoint=Vector2.new(1,0.5),
                    Position=UDim2.new(1,-6,0.5,0),
                    Size=UDim2.new(0,14,0,14),
                    BackgroundTransparency=1,
                    Text="▾",TextColor3=th.Acc,
                    TextSize=12,Font=Enum.Font.GothamBold,
                    ZIndex=6,Parent=disp
                })

                -- popup (parented to gui to escape clipping)
                local popup=New("Frame",{
                    Size=UDim2.new(0,160,0,0),
                    BackgroundColor3=th.DdBg,
                    ZIndex=20,ClipsDescendants=true,
                    Visible=false,Parent=gui
                })
                Corner(popup,8)
                Stroke(popup,th.Acc,1)

                local srchBox=New("TextBox",{
                    Size=UDim2.new(1,0,0,28),
                    BackgroundColor3=th.InBg,
                    Text="",PlaceholderText="  Search...",
                    TextColor3=th.InTxt,PlaceholderColor3=th.DescTxt,
                    TextSize=11,Font=Enum.Font.Gotham,
                    ClearTextOnFocus=false,ZIndex=21,Parent=popup
                })
                Stroke(srchBox,th.InBdr,1)

                local optFrame=New("ScrollingFrame",{
                    Position=UDim2.new(0,0,0,28),
                    Size=UDim2.new(1,0,1,-28),
                    BackgroundTransparency=1,
                    BorderSizePixel=0,
                    ScrollBarThickness=2,
                    ScrollBarImageColor3=th.Scroll,
                    CanvasSize=UDim2.new(0,0,0,0),
                    AutomaticCanvasSize=Enum.AutomaticSize.Y,
                    ZIndex=21,Parent=popup
                })
                List(optFrame,Enum.FillDirection.Vertical,2)
                Pad(optFrame,4,4)

                local optBtns={}
                local function BuildOpts(filter)
                    filter=filter and filter:lower() or ""
                    for _,ob in pairs(optBtns) do ob:Destroy() end
                    optBtns={}
                    for _,opt in ipairs(opts) do
                        if filter=="" or opt:lower():find(filter,1,true) then
                            local isSel=multi and sel[opt] or (sel==opt)
                            local ob=New("TextButton",{
                                Size=UDim2.new(1,0,0,26),
                                BackgroundColor3=isSel and th.DdSel or th.DdOpt,
                                Text=opt,
                                TextColor3=th.LblTxt,
                                TextSize=11,
                                Font=isSel and Enum.Font.GothamBold or Enum.Font.Gotham,
                                AutoButtonColor=false,
                                ZIndex=22,Parent=optFrame
                            })
                            Corner(ob,5)
                            ob.MouseEnter:Connect(function()
                                if not (not multi and sel==opt) then
                                    Tween(ob,{BackgroundColor3=th.CompHov},0.08)
                                end
                            end)
                            ob.MouseLeave:Connect(function()
                                local s2=multi and sel[opt] or (sel==opt)
                                Tween(ob,{BackgroundColor3=s2 and th.DdSel or th.DdOpt},0.08)
                            end)
                            ob.MouseButton1Click:Connect(function()
                                if multi then
                                    if sel[opt] then sel[opt]=nil else sel[opt]=true end
                                else
                                    sel=opt
                                    isOpen=false
                                    Tween(popup,{Size=UDim2.new(0,160,0,0)},0.18)
                                    task.delay(0.2,function() popup.Visible=false end)
                                end
                                if c.Flag then Veil.Flags[c.Flag]=sel end
                                disp.Text=SelText()
                                BuildOpts(srchBox.Text)
                                if c.Callback then c.Callback(sel) end
                            end)
                            table.insert(optBtns,ob)
                        end
                    end
                end
                BuildOpts()
                srchBox:GetPropertyChangedSignal("Text"):Connect(function() BuildOpts(srchBox.Text) end)

                disp.MouseButton1Click:Connect(function()
                    isOpen=not isOpen
                    if isOpen then
                        local ap=disp.AbsolutePosition
                        local as=disp.AbsoluteSize
                        popup.Position=UDim2.new(0,ap.X,0,ap.Y+as.Y+4)
                        popup.Visible=true
                        local h=math.min(#opts*30+38,200)
                        Spring(popup,{Size=UDim2.new(0,160,0,h)},0.3)
                    else
                        Tween(popup,{Size=UDim2.new(0,160,0,0)},0.18)
                        task.delay(0.2,function() popup.Visible=false end)
                    end
                end)

                -- close when clicking outside
                UIS.InputBegan:Connect(function(i)
                    if isOpen and i.UserInputType==Enum.UserInputType.MouseButton1 then
                        local mp=i.Position
                        local pa=popup.AbsolutePosition
                        local ps=popup.AbsoluteSize
                        if mp.X<pa.X or mp.X>pa.X+ps.X or mp.Y<pa.Y or mp.Y>pa.Y+ps.Y then
                            isOpen=false
                            Tween(popup,{Size=UDim2.new(0,160,0,0)},0.18)
                            task.delay(0.2,function() popup.Visible=false end)
                        end
                    end
                end)

                return RegComp({
                    _frame=r,_name=c.Name or "",
                    Set=function(self,v)
                        sel=v
                        if c.Flag then Veil.Flags[c.Flag]=v end
                        disp.Text=SelText()
                        BuildOpts()
                        if c.Callback then c.Callback(v) end
                    end,
                    Get=function(self) return sel end,
                    Refresh=function(self,newOpts)
                        opts=newOpts
                        BuildOpts()
                    end
                })
            end

            -- ════════════════════
            --  TEXTBOX
            -- ════════════════════
            function Sec:TextBox(c)
                c=c or {}
                local val=c.Default or ""
                if c.Flag then Veil.Flags[c.Flag]=val end
                local r=Row(36)
                Lbl(r,c.Name or "Input",12,0,120,36)

                local box=New("TextBox",{
                    AnchorPoint=Vector2.new(1,0.5),
                    Position=UDim2.new(1,-8,0.5,0),
                    Size=UDim2.new(0,160,0,24),
                    BackgroundColor3=th.InBg,
                    Text=val,
                    PlaceholderText=c.Placeholder or "Type here...",
                    TextColor3=th.InTxt,
                    PlaceholderColor3=th.InPh,
                    TextSize=11,Font=Enum.Font.Gotham,
                    ClearTextOnFocus=c.ClearOnFocus or false,
                    ZIndex=5,Parent=r
                })
                Corner(box,6)
                local bStroke=Stroke(box,th.InBdr,1)
                Pad(box,6,0)

                box.Focused:Connect(function() Tween(bStroke,{Color=th.Acc},0.15) end)
                box.FocusLost:Connect(function(enter)
                    Tween(bStroke,{Color=th.InBdr},0.15)
                    val=box.Text
                    if c.Flag then Veil.Flags[c.Flag]=val end
                    if c.Callback then c.Callback(val,enter) end
                end)

                return RegComp({
                    _frame=r,_name=c.Name or "",
                    Set=function(self,v) box.Text=v val=v if c.Flag then Veil.Flags[c.Flag]=v end end,
                    Get=function(self) return val end
                })
            end

            -- ════════════════════
            --  KEYBIND
            -- ════════════════════
            function Sec:Keybind(c)
                c=c or {}
                local key=c.Default or Enum.KeyCode.Unknown
                local listening=false
                if c.Flag then Veil.Flags[c.Flag]=key end
                local r=Row(36)
                Lbl(r,c.Name or "Keybind",12,0,200,36)

                local kb=New("TextButton",{
                    AnchorPoint=Vector2.new(1,0.5),
                    Position=UDim2.new(1,-8,0.5,0),
                    Size=UDim2.new(0,90,0,24),
                    BackgroundColor3=th.CompBg,
                    Text=key==Enum.KeyCode.Unknown and "None" or key.Name,
                    TextColor3=th.Acc,TextSize=11,Font=Enum.Font.GothamBold,
                    AutoButtonColor=false,ZIndex=5,Parent=r
                })
                Corner(kb,6)
                Stroke(kb,th.Acc,1)

                kb.MouseButton1Click:Connect(function()
                    listening=true
                    kb.Text="Press key..."
                    kb.TextColor3=th.SubTxt
                    Tween(kb,{BackgroundColor3=th.CompHov},0.1)
                end)
                UIS.InputBegan:Connect(function(i,gpe)
                    if listening and i.UserInputType==Enum.UserInputType.Keyboard then
                        if i.KeyCode==Enum.KeyCode.Escape then
                            key=Enum.KeyCode.Unknown
                            kb.Text="None"
                        else
                            key=i.KeyCode
                            kb.Text=key.Name
                        end
                        if c.Flag then Veil.Flags[c.Flag]=key end
                        kb.TextColor3=th.Acc
                        Tween(kb,{BackgroundColor3=th.CompBg},0.1)
                        listening=false
                        if c.Callback then c.Callback(key) end
                    end
                end)

                return RegComp({
                    _frame=r,_name=c.Name or "",
                    Get=function(self) return key end
                })
            end

            -- ════════════════════
            --  COLOR PICKER (HSV + hex + opacity)
            -- ════════════════════
            function Sec:ColorPicker(c)
                c=c or {}
                local color=c.Default or Color3.fromRGB(255,255,255)
                local opacity=c.Opacity or 1
                if c.Flag then Veil.Flags[c.Flag]={Color=color,Opacity=opacity} end

                local r=Row(36)
                Lbl(r,c.Name or "Color",12,0,200,36)

                local prev=New("TextButton",{
                    AnchorPoint=Vector2.new(1,0.5),
                    Position=UDim2.new(1,-8,0.5,0),
                    Size=UDim2.new(0,50,0,22),
                    BackgroundColor3=color,
                    Text="",AutoButtonColor=false,ZIndex=5,Parent=r
                })
                Corner(prev,5)
                Stroke(prev,th.CompBdr,1)

                -- checkerboard for opacity preview
                New("UIGradient",{
                    Color=ColorSequence.new({
                        ColorSequenceKeypoint.new(0,Color3.fromRGB(200,200,200)),
                        ColorSequenceKeypoint.new(0.5,Color3.fromRGB(200,200,200)),
                        ColorSequenceKeypoint.new(0.5,Color3.fromRGB(150,150,150)),
                        ColorSequenceKeypoint.new(1,Color3.fromRGB(150,150,150))
                    }),
                    Rotation=45,
                    Transparency=NumberSequence.new(1-opacity),
                    Parent=prev
                })

                local isOpen=false
                local picker=New("Frame",{
                    Size=UDim2.new(0,220,0,0),
                    BackgroundColor3=th.DdBg,
                    ZIndex=20,Visible=false,ClipsDescendants=true,Parent=gui
                })
                Corner(picker,10)
                Stroke(picker,th.Acc,1)
                List(picker,Enum.FillDirection.Vertical,6)
                Pad(picker,10,10)

                local h2,s2,v2=Color3.toHSV(color)
                local function Rebuild()
                    color=Color3.fromHSV(h2,s2,v2)
                    prev.BackgroundColor3=color
                    if c.Flag then Veil.Flags[c.Flag]={Color=color,Opacity=opacity} end
                    if c.Callback then c.Callback(color,opacity) end
                end

                local function MkHSVSlider(label,init,cb)
                    local sf=New("Frame",{Size=UDim2.new(1,0,0,44),BackgroundTransparency=1,Parent=picker})
                    New("TextLabel",{Size=UDim2.new(1,0,0,14),BackgroundTransparency=1,
                        Text=label,TextColor3=th.LblTxt,TextSize=10,Font=Enum.Font.Gotham,
                        TextXAlignment=Enum.TextXAlignment.Left,ZIndex=21,Parent=sf})
                    local trk=New("Frame",{Position=UDim2.new(0,0,0,18),Size=UDim2.new(1,0,0,8),
                        BackgroundColor3=th.SldTrack,ZIndex=21,Parent=sf})
                    Corner(trk,4)
                    local fl=New("Frame",{Size=UDim2.new(init,0,1,0),BackgroundColor3=th.Acc,ZIndex=22,Parent=trk})
                    Corner(fl,4)
                    local kn=New("Frame",{AnchorPoint=Vector2.new(0.5,0.5),
                        Position=UDim2.new(init,0,0.5,0),Size=UDim2.new(0,11,0,11),
                        BackgroundColor3=Color3.fromRGB(255,255,255),ZIndex=23,Parent=trk})
                    Corner(kn,6)
                    local dr=false
                    trk.InputBegan:Connect(function(i)
                        if i.UserInputType==Enum.UserInputType.MouseButton1 then
                            dr=true
                            local rel=math.clamp((i.Position.X-trk.AbsolutePosition.X)/trk.AbsoluteSize.X,0,1)
                            Tween(fl,{Size=UDim2.new(rel,0,1,0)},0.04)
                            Tween(kn,{Position=UDim2.new(rel,0,0.5,0)},0.04)
                            cb(rel)
                        end
                    end)
                    UIS.InputChanged:Connect(function(i)
                        if dr and i.UserInputType==Enum.UserInputType.MouseMovement then
                            local rel=math.clamp((i.Position.X-trk.AbsolutePosition.X)/trk.AbsoluteSize.X,0,1)
                            Tween(fl,{Size=UDim2.new(rel,0,1,0)},0.04)
                            Tween(kn,{Position=UDim2.new(rel,0,0.5,0)},0.04)
                            cb(rel)
                        end
                    end)
                    UIS.InputEnded:Connect(function(i)
                        if i.UserInputType==Enum.UserInputType.MouseButton1 then dr=false end
                    end)
                end
                MkHSVSlider("Hue",       h2, function(v) h2=v Rebuild() end)
                MkHSVSlider("Saturation",s2, function(v) s2=v Rebuild() end)
                MkHSVSlider("Brightness",v2, function(v) v2=v Rebuild() end)
                MkHSVSlider("Opacity",   opacity,function(v) opacity=v Rebuild() end)

                local hexBox=New("TextBox",{
                    Size=UDim2.new(1,0,0,26),
                    BackgroundColor3=th.InBg,
                    Text=string.format("#%02X%02X%02X",math.floor(color.R*255),math.floor(color.G*255),math.floor(color.B*255)),
                    TextColor3=th.InTxt,TextSize=11,Font=Enum.Font.Code,ZIndex=21,Parent=picker
                })
                Corner(hexBox,5)
                Stroke(hexBox,th.InBdr,1)
                hexBox.FocusLost:Connect(function()
                    local hx=hexBox.Text:gsub("#","")
                    if #hx==6 then
                        local rv=tonumber(hx:sub(1,2),16)
                        local gv=tonumber(hx:sub(3,4),16)
                        local bv=tonumber(hx:sub(5,6),16)
                        if rv and gv and bv then
                            color=Color3.fromRGB(rv,gv,bv)
                            h2,s2,v2=Color3.toHSV(color)
                            prev.BackgroundColor3=color
                            if c.Flag then Veil.Flags[c.Flag]={Color=color,Opacity=opacity} end
                            if c.Callback then c.Callback(color,opacity) end
                        end
                    end
                end)

                prev.MouseButton1Click:Connect(function()
                    isOpen=not isOpen
                    if isOpen then
                        local ap=prev.AbsolutePosition
                        picker.Position=UDim2.new(0,ap.X-90,0,ap.Y+30)
                        picker.Visible=true
                        Spring(picker,{Size=UDim2.new(0,220,0,260)},0.35)
                    else
                        Tween(picker,{Size=UDim2.new(0,220,0,0)},0.2)
                        task.delay(0.22,function() picker.Visible=false end)
                    end
                end)

                return RegComp({
                    _frame=r,_name=c.Name or "",
                    Set=function(self,col,op)
                        color=col
                        if op then opacity=op end
                        prev.BackgroundColor3=color
                        if c.Flag then Veil.Flags[c.Flag]={Color=color,Opacity=opacity} end
                        if c.Callback then c.Callback(color,opacity) end
                    end,
                    Get=function(self) return color,opacity end
                })
            end

            -- ════════════════════
            --  PROGRESS BAR
            -- ════════════════════
            function Sec:ProgressBar(c)
                c=c or {}
                local val=c.Default or 0    -- 0-100
                if c.Flag then Veil.Flags[c.Flag]=val end
                local r=Row(44)
                Lbl(r,c.Name or "Progress",12,5,250,16)
                local pLbl=New("TextLabel",{
                    AnchorPoint=Vector2.new(1,0),
                    Position=UDim2.new(1,-10,0,5),
                    Size=UDim2.new(0,50,0,16),
                    BackgroundTransparency=1,
                    Text=tostring(math.floor(val)).."%",
                    TextColor3=th.Acc,TextSize=10,Font=Enum.Font.GothamBold,
                    TextXAlignment=Enum.TextXAlignment.Right,ZIndex=5,Parent=r
                })
                local trk=New("Frame",{
                    Position=UDim2.new(0,12,0,26),
                    Size=UDim2.new(1,-24,0,8),
                    BackgroundColor3=th.PrgBg,ZIndex=4,Parent=r
                })
                Corner(trk,4)
                local fill=New("Frame",{
                    Size=UDim2.new(val/100,0,1,0),
                    BackgroundColor3=th.PrgFill,ZIndex=5,Parent=trk
                })
                Corner(fill,4)
                if th.PrgFill2 then Gradient(fill,th.PrgFill,th.PrgFill2,0) end

                return RegComp({
                    _frame=r,_name=c.Name or "",
                    Set=function(self,v)
                        val=math.clamp(v,0,100)
                        if c.Flag then Veil.Flags[c.Flag]=val end
                        Tween(fill,{Size=UDim2.new(val/100,0,1,0)},0.3)
                        pLbl.Text=tostring(math.floor(val)).."%"
                        if c.Callback then c.Callback(val) end
                    end,
                    Get=function(self) return val end
                })
            end

            -- ════════════════════
            --  LABEL
            -- ════════════════════
            function Sec:Label(c)
                c=c or {}
                local r=New("Frame",{
                    Size=UDim2.new(1,0,0,24),
                    BackgroundTransparency=1,Parent=compContainer
                })
                local lbl=New("TextLabel",{
                    Position=UDim2.new(0,12,0,0),Size=UDim2.new(1,-24,1,0),
                    BackgroundTransparency=1,
                    Text=c.Text or "",
                    TextColor3=c.Color or th.DescTxt,
                    TextSize=c.Size or 11,Font=Enum.Font.Gotham,
                    TextXAlignment=c.Align or Enum.TextXAlignment.Left,
                    TextWrapped=true,ZIndex=4,Parent=r
                })
                return RegComp({
                    _frame=r,_name=c.Text or "",
                    Set=function(self,txt) lbl.Text=txt end,
                    Get=function(self) return lbl.Text end
                })
            end

            -- ════════════════════
            --  PARAGRAPH (multi-line)
            -- ════════════════════
            function Sec:Paragraph(c)
                c=c or {}
                local r=New("Frame",{
                    Size=UDim2.new(1,0,0,0),
                    AutomaticSize=Enum.AutomaticSize.Y,
                    BackgroundTransparency=1,Parent=compContainer
                })
                Pad(r,12,6)
                if c.Title then
                    New("TextLabel",{
                        Size=UDim2.new(1,0,0,18),
                        BackgroundTransparency=1,
                        Text=c.Title,TextColor3=th.LblTxt,
                        TextSize=12,Font=Enum.Font.GothamBold,
                        TextXAlignment=Enum.TextXAlignment.Left,
                        ZIndex=4,Parent=r
                    })
                end
                New("TextLabel",{
                    Position=c.Title and UDim2.new(0,0,0,20) or UDim2.new(0,0,0,0),
                    Size=UDim2.new(1,0,0,0),
                    AutomaticSize=Enum.AutomaticSize.Y,
                    BackgroundTransparency=1,
                    Text=c.Text or "",
                    TextColor3=th.DescTxt,
                    TextSize=11,Font=Enum.Font.Gotham,
                    TextXAlignment=Enum.TextXAlignment.Left,
                    TextWrapped=true,ZIndex=4,Parent=r
                })
                return RegComp({_frame=r,_name=c.Title or c.Text or ""})
            end

            -- ════════════════════
            --  SEPARATOR
            -- ════════════════════
            function Sec:Separator(label)
                local r=New("Frame",{
                    Size=UDim2.new(1,0,0,label and 20 or 8),
                    BackgroundTransparency=1,Parent=compContainer
                })
                if label then
                    New("TextLabel",{
                        AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.new(0.5,0,0.5,0),
                        Size=UDim2.new(0,100,0,16),
                        BackgroundColor3=th.SecBg,
                        Text=label,TextColor3=th.SubTxt,TextSize=10,Font=Enum.Font.Gotham,
                        TextXAlignment=Enum.TextXAlignment.Center,ZIndex=5,Parent=r
                    })
                end
                New("Frame",{
                    AnchorPoint=Vector2.new(0,0.5),Position=UDim2.new(0,12,0.5,0),
                    Size=label and UDim2.new(0.35,-14,0,1) or UDim2.new(1,-24,0,1),
                    BackgroundColor3=th.Sep,BorderSizePixel=0,ZIndex=4,Parent=r
                })
                if label then
                    New("Frame",{
                        AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,-12,0.5,0),
                        Size=UDim2.new(0.35,-14,0,1),
                        BackgroundColor3=th.Sep,BorderSizePixel=0,ZIndex=4,Parent=r
                    })
                end
                return r
            end

            return Sec
        end -- Tab:Section

        return Tab
    end -- W:Tab

    -- ── WATERMARK ──────────────────────────────
    function W:Watermark(c)
        c=c or {}
        local wm=New("Frame",{
            Position=c.Position or UDim2.new(0,14,0,14),
            Size=UDim2.new(0,200,0,30),
            BackgroundColor3=th.WinBg,
            ZIndex=10,Parent=gui
        })
        Corner(wm,6)
        Stroke(wm,th.Acc,1)
        Pad(wm,8,0)
        local lbl=New("TextLabel",{
            Size=UDim2.new(1,0,1,0),
            BackgroundTransparency=1,
            Text=c.Text or (cfg.Title or "Veil").." | "..os.date("%H:%M"),
            TextColor3=th.LblTxt,TextSize=12,Font=Enum.Font.GothamBold,
            TextXAlignment=Enum.TextXAlignment.Left,ZIndex=11,Parent=wm
        })
        -- auto-update time if text contains %H:%M
        if c.UpdateTime then
            task.spawn(function()
                while wm.Parent do
                    lbl.Text=c.Text and c.Text:gsub("{time}",os.date("%H:%M"))
                        or (cfg.Title or "Veil").." | "..os.date("%H:%M")
                    task.wait(1)
                end
            end)
        end
        return {
            Set=function(self,txt) lbl.Text=txt end,
            Destroy=function(self) wm:Destroy() end
        }
    end

    -- ── CONFIG SYSTEM ──────────────────────────
    function W:SaveConfig(name)
        local data={}
        for flag,val in pairs(Veil.Flags) do
            local t=type(val)
            if t=="boolean" or t=="number" or t=="string" then
                data[flag]=val
            elseif typeof(val)=="EnumItem" then
                data[flag]="__enum__"..tostring(val)
            elseif typeof(val)=="Color3" then
                data[flag]={__type="Color3",R=val.R,G=val.G,B=val.B}
            elseif t=="table" and val.Color then
                data[flag]={__type="ColorOpacity",R=val.Color.R,G=val.Color.G,B=val.Color.B,O=val.Opacity}
            end
        end
        local ok,encoded=pcall(HS.JSONEncode,HS,data)
        if ok and writefile then
            pcall(writefile,"veil_cfg_"..name..".json",encoded)
            Notify({Title="Config Saved",Text=name..".json",Type="success",Theme=cfg.Theme})
        end
    end

    function W:LoadConfig(name)
        if not readfile then return end
        local ok,raw=pcall(readfile,"veil_cfg_"..name..".json")
        if not ok then return end
        local ok2,data=pcall(HS.JSONDecode,HS,raw)
        if not ok2 then return end
        for flag,val in pairs(data) do
            if type(val)=="table" then
                if val.__type=="Color3" then
                    Veil.Flags[flag]=Color3.new(val.R,val.G,val.B)
                elseif val.__type=="ColorOpacity" then
                    Veil.Flags[flag]={Color=Color3.new(val.R,val.G,val.B),Opacity=val.O}
                end
            elseif type(val)=="string" and val:sub(1,8)=="__enum__" then
                -- enum restoration is best-effort
                Veil.Flags[flag]=val:sub(9)
            else
                Veil.Flags[flag]=val
            end
        end
        Notify({Title="Config Loaded",Text=name..".json",Type="info",Theme=cfg.Theme})
    end

    -- startup notify
    task.spawn(function()
        task.wait(0.6)
        Notify({
            Title    = cfg.Title or "Veil",
            Text     = "Loaded successfully  •  Theme: "..(cfg.Theme or "Dark"),
            Type     = "success",
            Duration = 3,
            Theme    = cfg.Theme or "Dark"
        })
    end)

    return W
end -- CreateWindow

return Veil

