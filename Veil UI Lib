                local multi    = config.Multi    or false
                local selected = multi and {} or (config.Default or options[1])
                if config.Flag then Veil.Flags[config.Flag] = selected end

                local isOpen  = false
                local rowH    = 36

                local row = BaseRow(config.Name, rowH)
                Label(row, config.Name or "Dropdown", 10, 0, 160, rowH)

                local displayText = multi and "Select..." or (selected or "Select...")
                local display = New("TextButton", {
                    AnchorPoint      = Vector2.new(1, 0.5),
                    Position         = UDim2.new(1, -8, 0.5, 0),
                    Size             = UDim2.new(0, 130, 0, 24),
                    BackgroundColor3 = theme.DropdownBg,
                    Text             = displayText,
                    TextColor3       = theme.LabelText,
                    TextSize         = 11,
                    Font             = Enum.Font.Gotham,
                    AutoButtonColor  = false,
                    ClipsDescendants = true,
                    Parent           = row
                })
                RoundCorners(display, 5)
                New("UIStroke", { Color = theme.ComponentBorder, Thickness = 1, Parent = display })

                New("TextLabel", {
                    AnchorPoint     = Vector2.new(1, 0.5),
                    Position        = UDim2.new(1, -6, 0.5, 0),
                    Size            = UDim2.new(0, 12, 0, 12),
                    BackgroundTransparency = 1,
                    Text            = "▼",
                    TextColor3      = theme.Accent,
                    TextSize        = 8,
                    Font            = Enum.Font.GothamBold,
                    Parent          = display
                })

                -- popup list (parented to gui so it overlaps)
                local popup = New("Frame", {
                    Size             = UDim2.new(0, 130, 0, 0),
                    BackgroundColor3 = theme.DropdownBg,
                    ZIndex           = 10,
                    ClipsDescendants = true,
                    Visible          = false,
                    Parent           = gui
                })
                RoundCorners(popup, 6)
                New("UIStroke", { Color = theme.Accent, Thickness = 1, Parent = popup })

                local optList = New("Frame", {
                    Size             = UDim2.new(1, 0, 0, 0),
                    AutomaticSize    = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1,
                    Parent           = popup
                })
                AddListLayout(optList, Enum.FillDirection.Vertical, 2)
                AddPadding(optList, 4, 4)

                local function RefreshDisplay()
                    if multi then
                        local names = {}
                        for k in pairs(selected) do table.insert(names, k) end
                        display.Text = #names > 0 and table.concat(names, ", ") or "Select..."
                    else
                        display.Text = selected or "Select..."
                    end
                end

                local function BuildOptions()
                    for _, child in pairs(optList:GetChildren()) do
                        if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
                            child:Destroy()
                        end
                    end
                    for _, opt in ipairs(options) do
                        local isSelected = multi and selected[opt] or (selected == opt)
                        local optBtn = New("TextButton", {
                            Size             = UDim2.new(1, 0, 0, 26),
                            BackgroundColor3 = isSelected and theme.DropdownSelected or theme.DropdownOption,
                            Text             = opt,
                            TextColor3       = theme.LabelText,
                            TextSize         = 11,
                            Font             = isSelected and Enum.Font.GothamBold or Enum.Font.Gotham,
                            AutoButtonColor  = false,
                            ZIndex           = 11,
                            Parent           = optList
                        })
                        RoundCorners(optBtn, 4)
                        optBtn.MouseButton1Click:Connect(function()
                            if multi then
                                selected[opt] = not selected[opt] or nil
                            else
                                selected = opt
                                isOpen = false
                                Tween(popup, { Size = UDim2.new(0, 130, 0, 0) }, 0.2):Play()
                                task.delay(0.2, function() popup.Visible = false end)
                            end
                            if config.Flag then Veil.Flags[config.Flag] = selected end
                            RefreshDisplay()
                            BuildOptions()
                            if config.Callback then config.Callback(selected) end
                        end)
                    end
                end
                BuildOptions()

                display.MouseButton1Click:Connect(function()
                    isOpen = not isOpen
                    if isOpen then
                        local abs  = display.AbsolutePosition
                        local absS = display.AbsoluteSize
                        popup.Position = UDim2.new(0, abs.X, 0, abs.Y + absS.Y + 4)
                        popup.Visible  = true
                        local targetH  = math.min(#options * 30 + 12, 180)
                        Tween(popup, { Size = UDim2.new(0, 130, 0, targetH) }, 0.2):Play()
                    else
                        Tween(popup, { Size = UDim2.new(0, 130, 0, 0) }, 0.2):Play()
                        task.delay(0.2, function() popup.Visible = false end)
                    end
                end)

                local comp = {
                    _frame = row,
                    _name  = config.Name or "",
                    Set    = function(self, v)
                        selected = v
                        if config.Flag then Veil.Flags[config.Flag] = v end
                        RefreshDisplay()
                        BuildOptions()
                        if config.Callback then config.Callback(v) end
                    end,
                    Get    = function(self) return selected end,
                    Refresh = function(self, newOptions)
                        options = newOptions
                        BuildOptions()
                    end
                }
                table.insert(Section.Components, comp)
                table.insert(Tab.Components, comp)
                return comp
            end

