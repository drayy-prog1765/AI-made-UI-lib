--  UTILITY
-- ═══════════════════════════════════════════════════
local function New(class, props)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then
            o[k] = v
        end
    end
    if props and props.Parent then o.Parent = props.Parent end
    return o
end

local function Tween(obj, goal, t, style, dir)
    local ti = TweenInfo.new(
        t   or 0.18,
        style or Enum.EasingStyle.Quart,
        dir   or Enum.EasingDirection.Out
    )
    local tw = TS:Create(obj, ti, goal)
    tw:Play()
    return tw
end

-- spring tween for bouncy feel
local function Spring(obj, goal, t)
    Tween(obj, goal, t or 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

local function Corner(p, r)
    New("UICorner", { CornerRadius = UDim.new(0, r or 6), Parent = p })
end

local function Stroke(p, col, thick, mode)
    New("UIStroke", {
        Color     = col or Color3.fromRGB(60,60,80),
        Thickness = thick or 1,
        ApplyStrokeMode = mode or Enum.ApplyStrokeMode.Border,
        Parent    = p
    })
end

local function Pad(p, x, y)
    New("UIPadding", {
        PaddingLeft   = UDim.new(0,x), PaddingRight  = UDim.new(0,x),
        PaddingTop    = UDim.new(0,y), PaddingBottom = UDim.new(0,y),
        Parent = p
    })
end

local function List(p, dir, gap, sort)
    New("UIListLayout", {
        FillDirection     = dir  or Enum.FillDirection.Vertical,
        Padding           = UDim.new(0, gap or 4),
        SortOrder         = sort or Enum.SortOrder.LayoutOrder,
        Parent            = p
    })
end

local function Gradient(p, c0, c1, rot)
    New("UIGradient", {
        Color    = ColorSequence.new(c0, c1),
        Rotation = rot or 90,
        Parent   = p
    })
end

local function GlowFrame(parent, color, size, pos)
    New("ImageLabel", {
        AnchorPoint          = Vector2.new(0.5,0.5),
        Position             = pos or UDim2.new(0.5,0,0.5,0),
        Size                 = size or UDim2.new(1,40,1,40),
        BackgroundTransparency = 1,
        Image                = "rbxassetid://7912134082",
        ImageColor3          = color or Color3.fromRGB(100,80,255),
        ImageTransparency    = 0.85,
        ScaleType            = Enum.ScaleType.Slice,
        SliceCenter          = Rect.new(49,49,450,450),
        ZIndex               = -1,
        Parent               = parent
    })
end

local function MakeDrag(frame, handle)
    handle = handle or frame
    local drag, dStart, fStart = false
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            drag   = true
            dStart = i.Position
            fStart = frame.Position
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement
                  or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - dStart
            frame.Position = UDim2.new(
                fStart.X.Scale, fStart.X.Offset + d.X,
                fStart.Y.Scale, fStart.Y.Offset + d.Y
            )
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            drag = false
        end
    end)
end

