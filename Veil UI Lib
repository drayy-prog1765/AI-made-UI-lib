                    local track = New("Frame", {
                        Position = UDim2.new(0, 0, 0, 18),
                        Size = UDim2.new(1, 0, 0, 8),
                        BackgroundColor3 = theme.SliderTrack,
                        Parent = f
                    })
                    RoundCorners(track, 4)
                    local fill = New("Frame", {
                        Size = UDim2.new(initial, 0, 1, 0),
                        BackgroundColor3 = theme.Accent,
                        Parent = track
                    })
                    RoundCorners(fill, 4)
                    local knob = New("Frame", {
                        AnchorPoint = Vector2.new(0.5, 0.5),
                        Position = UDim2.new(initial, 0, 0.5, 0),
                        Size = UDim2.new(0, 10, 0, 10),
                        BackgroundColor3 = Color3.fromRGB(255,255,255),
                        ZIndex = 16,
                        Parent = track
                    })
                    RoundCorners(knob, 5)

                    local dragging = false
                    track.InputBegan:Connect(function(i)
                        if i.UserInputType == Enum.UserInputType.MouseButton1 then
                            dragging = true
                            local rel = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                            Tween(fill,  { Size = UDim2.new(rel, 0, 1, 0) }, 0.05):Play()
                            Tween(knob,  { Position = UDim2.new(rel, 0, 0.5, 0) }, 0.05):Play()
                            callback(rel)
                        end
                    end)
                    UserInputService.InputChanged:Connect(function(i)
                        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                            local rel = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                            Tween(fill,  { Size = UDim2.new(rel, 0, 1, 0) }, 0.05):Play()
                            Tween(knob,  { Position = UDim2.new(rel, 0, 0.5, 0) }, 0.05):Play()
                            callback(rel)
                        end
                    end)
                    UserInputService.InputEnded:Connect(function(i)
                        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
                    end)
                end

                HSVSlider("Hue", h, function(val) h = val RebuildColor() end)
                HSVSlider("Saturation", s, function(val) s = val RebuildColor() end)
                HSVSlider("Value", v, function(val) v = val RebuildColor() end)

                -- hex input
                local hexBox = New("TextBox", {
                    Size = UDim2.new(1, 0, 0, 24),
                    BackgroundColor3 = theme.InputBg,
                    Text = string.format("#%02X%02X%02X", color.R*255, color.G*255, color.B*255),
                    TextColor3 = theme.InputText,
                    TextSize = 11,
                    Font = Enum.Font.Code,
                    Parent = picker
                })
                RoundCorners(hexBox, 4)
                New("UIStroke", { Color = theme.InputBorder, Thickness = 1, Parent = hexBox })
                hexBox.FocusLost:Connect(function()
                    local hex = hexBox.Text:gsub("#", "")
                    if #hex == 6 then
                        local r = tonumber(hex:sub(1,2), 16)
                        local g = tonumber(hex:sub(3,4), 16)
                        local b = tonumber(hex:sub(5,6), 16)
                        if r and g and b then
                            color = Color3.fromRGB(r, g, b)
                            h, s, v = Color3.toHSV(color)
                            preview.BackgroundColor3 = color
                            if config.Flag then Veil.Flags[config.Flag] = color end
                            if config.Callback then config.Callback(color) end
                        end
                    end
                end)

                preview.MouseButton1Click:Connect(function()
                    isOpen = not isOpen
                    if isOpen then
                        local abs = preview.AbsolutePosition
                        picker.Position = UDim2.new(0, abs.X - 80, 0, abs.Y + 30)
                        picker.Visible = true
                    else
                        picker.Visible = false
                    end
                end)

                local comp = {
                    _frame = row,
                    _name  = config.Name or "",
                    Set    = function(self, c)
                        color = c
                        preview.BackgroundColor3 = c
                        if config.Flag then Veil.Flags[config.Flag] = c end
                        if config.Callback then config.Callback(c) end
                    end,
                    Get    = function(self) return color end
                }
                table.insert(Section.Components, comp)
                table.insert(Tab.Components, comp)
                return comp
            end

            return Section
        end -- Tab:Section

        return Tab
    end -- Window:Tab

    -- ── WINDOW THEME SWITCHER BUTTON ─────────────
    local themeNames = {}
    for k in pairs(Veil.Themes) do table.insert(themeNames, k) end

    -- startup notification
    task.spawn(function()
        task.wait(0.5)
        Veil:Notify({
            Title    = config.Title or "Veil",
            Text     = "UI loaded. Theme: " .. (config.Theme or "Dark"),
            Duration = 3,
            Theme    = config.Theme or "Dark"
        })
    end)

    table.insert(Veil.Windows, Window)
    return Window
end

-- ══════════════════════════════════════════
--  CONFIG SAVE / LOAD (via writefile/readfile)
-- ══════════════════════════════════════════
function Veil:SaveConfig(name)
    local data = {}
    for flag, val in pairs(self.Flags) do
        if type(val) == "boolean" or type(val) == "number" or type(val) == "string" then
            data[flag] = val
        elseif typeof(val) == "EnumItem" then
            data[flag] = tostring(val)
        elseif typeof(val) == "Color3" then
            data[flag] = { val.R, val.G, val.B }
        end
    end
    local encoded = game:GetService("HttpService"):JSONEncode(data)
    if writefile then
        writefile("veil_" .. name .. ".json", encoded)
        self:Notify({ Title = "Config", Text = "Saved: " .. name, Duration = 2 })
    end
end

function Veil:LoadConfig(name)
    if not readfile then return end
    local ok, raw = pcall(readfile, "veil_" .. name .. ".json")
    if not ok or not raw then return end
    local ok2, data = pcall(function() return game:GetService("HttpService"):JSONDecode(raw) end)
    if not ok2 or not data then return end
    for flag, val in pairs(data) do
        if type(val) == "table" and #val == 3 then
            self.Flags[flag] = Color3.new(val[1], val[2], val[3])
        else
            self.Flags[flag] = val
        end
    end
    self:Notify({ Title = "Config", Text = "Loaded: " .. name, Duration = 2 })
end

return Veil

