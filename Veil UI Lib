            -- ══════════════════════
            --  SLIDER
            -- ══════════════════════
            function Section:Slider(config)
                config = config or {}
                local min  = config.Min     or 0
                local max  = config.Max     or 100
                local step = config.Step    or 1
                local val  = config.Default or min
                if config.Flag then Veil.Flags[config.Flag] = val end

                local row = BaseRow(config.Name, 50)
                Label(row, config.Name or "Slider", 10, 4, 200, 16)
                local valLabel = Label(row, tostring(val) .. (config.Suffix or ""), 0, 4, 0, 16, 11, Enum.Font.GothamBold, theme.Accent, Enum.TextXAlignment.Right)
                valLabel.Position = UDim2.new(1, -10, 0, 4)
                valLabel.Size     = UDim2.new(0, 80, 0, 16)

                local track = New("Frame", {
                    Position         = UDim2.new(0, 10, 0, 28),
                    Size             = UDim2.new(1, -20, 0, 6),
                    BackgroundColor3 = theme.SliderTrack,
                    Parent           = row
                })
                RoundCorners(track, 3)
                local fill = New("Frame", {
                    Size             = UDim2.new((val - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = theme.SliderFill,
                    Parent           = track
                })
                RoundCorners(fill, 3)
                local knob = New("Frame", {
                    AnchorPoint      = Vector2.new(0.5, 0.5),
                    Position         = UDim2.new((val - min) / (max - min), 0, 0.5, 0),
                    Size             = UDim2.new(0, 12, 0, 12),
                    BackgroundColor3 = theme.SliderKnob,
                    ZIndex           = 3,
                    Parent           = track
                })
                RoundCorners(knob, 6)

                local dragging = false
                local function Update(input)
                    local rel = math.clamp(
                        (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X,
                        0, 1
                    )
                    local raw  = min + (max - min) * rel
                    val        = math.round(raw / step) * step
                    val        = math.clamp(val, min, max)
                    if config.Flag then Veil.Flags[config.Flag] = val end
                    local pct = (val - min) / (max - min)
                    Tween(fill,  { Size     = UDim2.new(pct, 0, 1, 0) }, 0.05):Play()
                    Tween(knob,  { Position = UDim2.new(pct, 0, 0.5, 0) }, 0.05):Play()
                    valLabel.Text = tostring(val) .. (config.Suffix or "")
                    if config.Callback then config.Callback(val) end
                end

                track.InputBegan:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                        Update(i)
                    end
                end)
                UserInputService.InputChanged:Connect(function(i)
                    if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                        Update(i)
                    end
                end)
                UserInputService.InputEnded:Connect(function(i)
                    if i.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                    end
                end)

                local comp = {
                    _frame = row,
                    _name  = config.Name or "",
                    Set    = function(self, v)
                        val = math.clamp(v, min, max)
                        if config.Flag then Veil.Flags[config.Flag] = val end
                        local pct = (val - min) / (max - min)
                        Tween(fill,  { Size     = UDim2.new(pct, 0, 1, 0) }, 0.15):Play()
                        Tween(knob,  { Position = UDim2.new(pct, 0, 0.5, 0) }, 0.15):Play()
                        valLabel.Text = tostring(val) .. (config.Suffix or "")
                        if config.Callback then config.Callback(val) end
                    end,
                    Get    = function(self) return val end
                }
                table.insert(Section.Components, comp)
                table.insert(Tab.Components, comp)
                return comp
            end

