                and UDim2.new(0, config.Width or 580, 0, config.Height or 400)
                or  UDim2.new(0, config.Width or 580, 0, 44)
        }, 0.25):Play()
    end)

    MakeDraggable(main, titleBar)

    -- tab bar
    local tabBar = New("Frame", {
