--  NOTIFICATION SYSTEM
-- ═══════════════════════════════════════════════════
local NotifGui, NotifHolder

local NOTIF_ICONS = {
    info    = "ℹ️",
    success = "✅",
    warn    = "⚠️",
    error   = "❌",
}

local function EnsureNotif()
    if NotifGui and NotifGui.Parent then return end
    NotifGui = New("ScreenGui", {
        Name           = "VeilNotif",
        ResetOnSpawn   = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent         = GetParent()
    })
    NotifHolder = New("Frame", {
        AnchorPoint = Vector2.new(1,1),
        Position    = UDim2.new(1,-14,1,-14),
        Size        = UDim2.new(0,310,1,-28),
        BackgroundTransparency = 1,
        Parent      = NotifGui
    })
    List(NotifHolder, Enum.FillDirection.Vertical, 8)
    NotifHolder.UIListLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
end

local function Notify(opts)
    opts = opts or {}
    local th       = Themes[opts.Theme or "Dark"]
    local title    = opts.Title    or "Veil"
    local text     = opts.Text     or ""
    local dur      = opts.Duration or 4
    local ntype    = opts.Type     or "info"
    local accent   = opts.Accent   or th.Acc

    EnsureNotif()
    task.spawn(function()
        local card = New("Frame", {
            Size             = UDim2.new(1,0,0,0),
            BackgroundColor3 = th.NotBg,
            ClipsDescendants = true,
            Parent           = NotifHolder
        })
        Corner(card, 8)
        Stroke(card, accent, 1)
        GlowFrame(card, accent, UDim2.new(1,30,1,30))

        -- side accent bar
        local bar = New("Frame", {
            Size             = UDim2.new(0,3,1,0),
            BackgroundColor3 = accent,
            BorderSizePixel  = 0,
            ZIndex           = 2,
            Parent           = card
        })
        Gradient(bar, accent, th.Acc2 or accent, 180)
        Corner(bar, 2)

        local body = New("Frame", {
            Position             = UDim2.new(0,12,0,0),
            Size                 = UDim2.new(1,-12,1,0),
            BackgroundTransparency = 1,
            Parent               = card
        })
        Pad(body, 8, 8)
        List(body, Enum.FillDirection.Vertical, 3)

        New("TextLabel", {
            Size            = UDim2.new(1,0,0,18),
            BackgroundTransparency = 1,
            Text            = (NOTIF_ICONS[ntype] or "•") .. "  " .. title,
            TextColor3      = th.NotTtl,
            TextSize        = 13,
            Font            = Enum.Font.GothamBold,
            TextXAlignment  = Enum.TextXAlignment.Left,
            Parent          = body
        })
        New("TextLabel", {
            Size            = UDim2.new(1,0,0,28),
            BackgroundTransparency = 1,
            Text            = text,
            TextColor3      = th.NotTxt,
            TextSize        = 11,
            Font            = Enum.Font.Gotham,
            TextXAlignment  = Enum.TextXAlignment.Left,
            TextWrapped     = true,
            Parent          = body
        })

        -- progress bar
        local prog = New("Frame", {
            AnchorPoint      = Vector2.new(0,1),
            Position         = UDim2.new(0,0,1,0),
            Size             = UDim2.new(1,0,0,2),
            BackgroundColor3 = accent,
            BorderSizePixel  = 0,
            Parent           = card
        })
        Gradient(prog, accent, th.Acc2 or accent, 0)

        -- animate in
        Tween(card, { Size = UDim2.new(1,0,0,80) }, 0.3, Enum.EasingStyle.Back)
        task.wait(0.3)
        Tween(prog, { Size = UDim2.new(0,0,0,2) }, dur, Enum.EasingStyle.Linear)
        task.delay(dur, function()
            Tween(card, { Size = UDim2.new(1,0,0,0) }, 0.22)
            task.wait(0.25)
            card:Destroy()
        end)
    end)
end

